<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="MainWindow"
    Title="Codex 账号管理器"
    Width="1040"
    Height="690"
    MinWidth="960"
    MinHeight="690"
    WindowStartupLocation="CenterScreen"
    Background="#FF172436"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontFamily="Microsoft YaHei UI, Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <Window.Resources>
        <sys:Double x:Key="Qiehao.ButtonHeight">36</sys:Double>
        <sys:Double x:Key="Qiehao.GridRowHeight">32</sys:Double>
        <sys:Double x:Key="Qiehao.GridHeaderHeight">34</sys:Double>
        <CornerRadius x:Key="Qiehao.CardCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="Qiehao.ControlCornerRadius">8</CornerRadius>
        <Thickness x:Key="Qiehao.CardPadding">14</Thickness>
        <Thickness x:Key="Qiehao.ButtonPadding">15,6</Thickness>
        <Thickness x:Key="Qiehao.ControlPadding">10,5</Thickness>

        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#96394E66" Offset="0" />
            <GradientStop Color="#8A1D3046" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#88A7C9E8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F8FC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFD0DCE8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9FB2C4" />
        <SolidColorBrush x:Key="BrandWatermarkBrush" Color="#2D7EC8FF" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#C41B2B3D" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#AA6F91B2" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#FF8CCBFF" />
        <SolidColorBrush x:Key="ButtonOnAccentBrush" Color="#FFF7FBFF" />
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF2E6FAF" />
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FF3E82C7" />
        <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#FF245A91" />
        <SolidColorBrush x:Key="PositiveButtonBrush" Color="#FF2D7D5A" />
        <SolidColorBrush x:Key="PositiveButtonHoverBrush" Color="#FF38976C" />
        <SolidColorBrush x:Key="PositiveButtonPressedBrush" Color="#FF246649" />
        <SolidColorBrush x:Key="InfoButtonBrush" Color="#FF247A91" />
        <SolidColorBrush x:Key="InfoButtonHoverBrush" Color="#FF2D91AB" />
        <SolidColorBrush x:Key="InfoButtonPressedBrush" Color="#FF1D6377" />
        <SolidColorBrush x:Key="AccentButtonBrush" Color="#FF585FA8" />
        <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#FF6C74C2" />
        <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#FF474D8D" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#B83D5369" />
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#D04B657F" />
        <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#D032465B" />
        <SolidColorBrush x:Key="DangerButtonSolidBrush" Color="#FF9D4451" />
        <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#FFB65260" />
        <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="#FF833743" />
        <LinearGradientBrush x:Key="ButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E04F769E" Offset="0" />
            <GradientStop Color="#E02B4E73" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F06087B1" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#E023405F" />
        <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#A0445362" />
        <LinearGradientBrush x:Key="DangerButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E08F5D68" Offset="0" />
            <GradientStop Color="#E06F3F4A" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ActiveRowBrush" Color="#C03B6FA8" />
        <SolidColorBrush x:Key="ActiveSelectedRowBrush" Color="#E04487CF" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#B85C4B7D" />
        <SolidColorBrush x:Key="GridHoverBrush" Color="#3A7EC8FF" />
        <SolidColorBrush x:Key="ActiveBorderBrush" Color="#FF7EC8FF" />
        <SolidColorBrush x:Key="RunningWarningBrush" Color="#FFFFAAA4" />
        <SolidColorBrush x:Key="UnknownWarningBrush" Color="#FFFFB84D" />
        <SolidColorBrush x:Key="ColumnHeaderBackgroundBrush" Color="#FF233B55" />
        <SolidColorBrush x:Key="ColumnHeaderForegroundBrush" Color="#FFF7FBFF" />
        <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FF6F91B2" />
        <SolidColorBrush x:Key="CurrentYesBrush" Color="#FF72E6A6" />
        <SolidColorBrush x:Key="CurrentNoBrush" Color="#FFFFC56B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5CC58A" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF2D7D5A" />
        <SolidColorBrush x:Key="InfoBrush" Color="#FF247A91" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB84D" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF9D4451" />
        <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F01B2B3D" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#CC7EC8FF" />
        <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#FFF7FBFF" />
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF233B55" />
        <LinearGradientBrush x:Key="DialogCardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#96394E66" Offset="0" />
            <GradientStop Color="#8A1D3046" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#FF7EC8FF" />
        <SolidColorBrush x:Key="DialogForegroundBrush" Color="#FFF4F8FC" />
        <SolidColorBrush x:Key="DialogSecondaryBrush" Color="#FFD0DCE8" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#FF7EC8FF" />
        <SolidColorBrush x:Key="DialogWarningBrush" Color="#FFFFAAA4" />
        <SolidColorBrush x:Key="DialogSuccessBrush" Color="#FF72E6A6" />
        <SolidColorBrush x:Key="DialogButtonBackgroundBrush" Color="#FFF7FBFF" />
        <SolidColorBrush x:Key="DialogButtonForegroundBrush" Color="#FF233B55" />
        <SolidColorBrush x:Key="DialogButtonBorderBrush" Color="#FF7EC8FF" />
        <SolidColorBrush x:Key="GridBackgroundBrush" Color="#4AFFFFFF" />
        <SolidColorBrush x:Key="GridRowBrush" Color="#34FFFFFF" />
        <SolidColorBrush x:Key="GridAltRowBrush" Color="#22FFFFFF" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Qiehao.CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource Qiehao.CardPadding}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.20" ShadowDepth="3" Color="#FF07111E" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="{StaticResource Qiehao.ButtonHeight}" />
            <Setter Property="Padding" Value="{StaticResource Qiehao.ButtonPadding}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FocusRing" Margin="-2" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" />
                            <Border x:Name="ButtonShell" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Qiehao.ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter TargetName="ButtonShell" Property="Background" Value="{DynamicResource ButtonDisabledBrush}" />
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.76" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonPressedBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonOnAccentBrush}" /><Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" /></MultiTrigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}" /></MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PositiveButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonOnAccentBrush}" /><Setter Property="Background" Value="{DynamicResource PositiveButtonBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PositiveButtonHoverBrush}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource PositiveButtonHoverBrush}" /></MultiTrigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource PositiveButtonPressedBrush}" /></MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonOnAccentBrush}" /><Setter Property="Background" Value="{DynamicResource InfoButtonBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InfoButtonHoverBrush}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource InfoButtonHoverBrush}" /></MultiTrigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource InfoButtonPressedBrush}" /></MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonOnAccentBrush}" /><Setter Property="Background" Value="{DynamicResource AccentButtonBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentButtonHoverBrush}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentButtonHoverBrush}" /></MultiTrigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" /></MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonOnAccentBrush}" /><Setter Property="Background" Value="{DynamicResource DangerButtonSolidBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerButtonHoverBrush}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}" /></MultiTrigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource DangerButtonPressedBrush}" /></MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="{StaticResource Qiehao.ControlPadding}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxShell" CornerRadius="{StaticResource Qiehao.ControlCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxShell" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /><Setter TargetName="TextBoxShell" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxShell" Property="Opacity" Value="0.72" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Data="M 0 0 L 4 4 L 8 0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource GridHoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4,28,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboShell" CornerRadius="{StaticResource Qiehao.ControlCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <ToggleButton Style="{StaticResource ComboToggleStyle}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,4,0,0" Padding="4" CornerRadius="8" Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource ToolTipBorderBrush}" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /><Setter TargetName="ComboShell" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboShell" Property="Opacity" Value="0.72" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,4,0,0" /><Setter Property="Padding" Value="8,3" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
        <Style x:Key="FooterStatusBarStyle" TargetType="Border"><Setter Property="Padding" Value="10,4" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ColumnHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ColumnHeaderForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColumnHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
        <Style x:Key="AccountGridLeftTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="AccountGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AccountGridLeftTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="BackgroundOverlay" Background="#66101D2B" />
        <Canvas x:Name="BrandWatermarkLayer" IsHitTestVisible="False">
            <TextBlock x:Name="BrandWatermarkText"
                       Canvas.Left="36"
                       Canvas.Top="52"
                       Text="ZCT"
                       FontSize="82"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandWatermarkBrush}"
                       IsHitTestVisible="False"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-30" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderTitleText" Grid.Column="0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="Codex 账号管理器" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeLabelText" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="皮肤：" />
                            <ComboBox x:Name="ThemeComboBox" Width="168" MinHeight="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock x:Name="LanguageLabelText" Margin="14,0,8,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="语言：" />
                            <ComboBox x:Name="LanguageComboBox" Width="105" MinHeight="30" DisplayMemberPath="NativeName" SelectedValuePath="Code" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="CodexClientLabelText" Style="{StaticResource SecondaryTextStyle}" Text="Codex 客户端" />
                            <Border Style="{StaticResource StatusChipStyle}"><TextBlock x:Name="CodexStatusText" Style="{StaticResource StatusValueStyle}" Text="未知" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock x:Name="CurrentAccountLabelText" Style="{StaticResource SecondaryTextStyle}" Text="当前账号" />
                            <Border Style="{StaticResource StatusChipStyle}"><TextBlock x:Name="ActiveProfileText" Style="{StaticResource StatusValueStyle}" Text="未初始化" TextTrimming="CharacterEllipsis" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock x:Name="CurrentIdentityLabelText" Style="{StaticResource SecondaryTextStyle}" Text="当前身份确认" />
                            <Border Style="{StaticResource StatusChipStyle}"><TextBlock x:Name="IdentityStatusText" Style="{StaticResource StatusValueStyle}" Text="无法确认" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="WebChatGPTLabelText" Style="{StaticResource SecondaryTextStyle}" Text="网页 ChatGPT" />
                            <Border Style="{StaticResource StatusChipStyle}"><TextBlock x:Name="WebChatGPTText" Style="{StaticResource StatusValueStyle}" Text="不受影响" /></Border>
                            <TextBlock x:Name="WebChatGPTHintText" Margin="0,3,0,0" FontSize="11" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Text="浏览器 / PWA 登录状态不会被本工具修改" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <TextBlock x:Name="CodexSafetyHintText"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource UnknownWarningBrush}"
                                   Text="正在检测 Codex 进程状态……" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="SavedAccountsHeadingText" Style="{StaticResource SectionHeadingStyle}" Text="已保存账号" />
                        <TextBlock x:Name="ProfileCountText" DockPanel.Dock="Right" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Text="0 个账号" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchAccountsLabelText" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="搜索账号：" />
                        <TextBox x:Name="ProfileSearchTextBox" Grid.Column="1" MinHeight="30" Padding="7,4" ToolTip="仅按本地 Profile 名称搜索，不访问凭证或身份内容" />
                    </Grid>
                    <DataGrid
                        x:Name="ProfilesGrid" Grid.Row="4" AutoGenerateColumns="False"
                        CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                        IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        Background="{DynamicResource GridBackgroundBrush}"
                        AlternationCount="2"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                        CanUserResizeColumns="True" ColumnHeaderHeight="34" RowHeight="32"
                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="ProfileContextMenu">
                                <MenuItem x:Name="ContextSwitchMenuItem" Header="切换到此账号" />
                                <MenuItem x:Name="ContextVerifyMenuItem" Header="验证账号" />
                                <Separator />
                                <MenuItem x:Name="ContextRenameMenuItem" Header="重命名" />
                                <MenuItem x:Name="ContextDeleteMenuItem" Header="删除账号" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveCode}" Value="Yes" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Column.DisplayIndex}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ActiveBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="{DynamicResource GridRowBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource GridAltRowBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource GridHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ActiveCode}" Value="Yes">
                                        <Setter Property="Background" Value="{DynamicResource ActiveRowBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveCode}" Value="Yes" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ActiveSelectedRowBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ProfileColumn" Header="名称" Binding="{Binding Name}" MinWidth="120" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AccountGridLeftTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="CurrentColumn" Header="当前" Binding="{Binding Active}" MinWidth="55" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AccountGridCenterTextStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource CurrentNoBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveCode}" Value="Yes">
                                                <Setter Property="Foreground" Value="{DynamicResource CurrentYesBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveCode}" Value="No">
                                                <Setter Property="Foreground" Value="{DynamicResource CurrentNoBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="VerificationColumn" Header="槽位验证" Binding="{Binding Verification}" MinWidth="80" Width="86" ElementStyle="{StaticResource AccountGridCenterTextStyle}" />
                            <DataGridTextColumn x:Name="HealthColumn" Header="状态" Binding="{Binding Health}" MinWidth="64" Width="68">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AccountGridCenterTextStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthCode}" Value="READY"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthCode}" Value="INCOMPLETE_PROFILE"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HealthCode}" Value="INVALID_METADATA"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="AuthColumn" Header="凭证" Binding="{Binding Auth}" MinWidth="64" Width="70" ElementStyle="{StaticResource AccountGridCenterTextStyle}" />
                            <DataGridTextColumn x:Name="IdentityColumn" Header="身份标记" Binding="{Binding Identity}" MinWidth="72" Width="78" ElementStyle="{StaticResource AccountGridCenterTextStyle}" />
                            <DataGridTextColumn x:Name="MetadataColumn" Header="元数据" Binding="{Binding Metadata}" MinWidth="68" Width="74" ElementStyle="{StaticResource AccountGridCenterTextStyle}" />
                            <DataGridTextColumn x:Name="UpdatedColumn" Header="更新时间" Binding="{Binding UpdatedDisplay}" MinWidth="145" Width="148" ElementStyle="{StaticResource AccountGridCenterTextStyle}" />
                            <DataGridTemplateColumn x:Name="QuotaColumn" Header="" MinWidth="150" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="6,0"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Left"
                                                   Text="{Binding QuotaSummary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding QuotaToolTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button x:Name="SwitchButton" Content="切换账号" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                        <Button x:Name="VerifyButton" Content="验证账号" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource SecondaryButtonStyle}" IsDefault="True" />
                        <Button x:Name="RefreshQuotaButton" Content="" Style="{StaticResource InfoButtonStyle}" IsEnabled="False" />
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <Button x:Name="AddButton" Content="添加账号" Style="{StaticResource PositiveButtonStyle}" IsEnabled="False" />
                            <Button x:Name="RenameButton" Content="重命名" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                            <Button x:Name="DeleteButton" Content="删除账号" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1">
                            <Button x:Name="LaunchCodexButton" Content="启动 Codex" Style="{StaticResource PositiveButtonStyle}" IsEnabled="False" Margin="0" />
                        </WrapPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LaunchTargetText" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Codex 启动目标：检测中" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LaunchSettingsButton" Grid.Column="1" Content="启动设置" Style="{StaticResource SecondaryButtonStyle}" MinHeight="30" Padding="12,4" Margin="8,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource FooterStatusBarStyle}">
                <DockPanel>
                    <TextBlock x:Name="RefreshStatusText" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Text="准备就绪" />
                    <TextBlock x:Name="BrowserSafetyFooterText" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}" Text="不访问浏览器或网页登录状态" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
